Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /PointCloud21
        - /PointCloud22
        - /PointCloud23
      Splitter Ratio: 0.5
    Tree Height: 330
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        camera_first2_color_frame:
          Value: true
        camera_first2_color_optical_frame:
          Value: true
        camera_first2_depth_frame:
          Value: true
        camera_first2_depth_optical_frame:
          Value: true
        camera_first2_link:
          Value: true
        camera_left_color_frame:
          Value: true
        camera_left_color_optical_frame:
          Value: true
        camera_left_depth_frame:
          Value: true
        camera_left_depth_optical_frame:
          Value: true
        camera_left_link:
          Value: true
        camera_right_color_frame:
          Value: true
        camera_right_color_optical_frame:
          Value: true
        camera_right_depth_frame:
          Value: true
        camera_right_depth_optical_frame:
          Value: true
        camera_right_link:
          Value: true
        camera_top_color_frame:
          Value: true
        camera_top_color_optical_frame:
          Value: true
        camera_top_depth_frame:
          Value: true
        camera_top_depth_optical_frame:
          Value: true
        camera_top_link:
          Value: true
        left_base_link:
          Value: true
        right_base_link:
          Value: true
        world:
          Value: true
      Marker Scale: 0.30000001192092896
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        camera_first2_link:
          camera_first2_color_frame:
            camera_first2_color_optical_frame:
              {}
          camera_first2_depth_frame:
            camera_first2_depth_optical_frame:
              {}
        camera_top_link:
          camera_top_color_frame:
            camera_top_color_optical_frame:
              camera_left_link:
                camera_left_color_frame:
                  camera_left_color_optical_frame:
                    {}
                camera_left_depth_frame:
                  camera_left_depth_optical_frame:
                    {}
              camera_right_link:
                camera_right_color_frame:
                  camera_right_color_optical_frame:
                    {}
                camera_right_depth_frame:
                  camera_right_depth_optical_frame:
                    {}
          camera_top_depth_frame:
            camera_top_depth_optical_frame:
              {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: PointCloud2
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/camera_right/depth/color/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
